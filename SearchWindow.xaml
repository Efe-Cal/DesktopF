<Window x:Class="DesktopF.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopF"
        Height="112"
        MinWidth="560"
        MaxWidth="750"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" WindowStartupLocation="Manual">
    
    <Border Background="#F3F3F3" BorderBrush="#28000000" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="1" />
                <RowDefinition Height="51" />
            </Grid.RowDefinitions>


            <Grid Grid.Row="0" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="24" Height="24" HorizontalAlignment="Left">
                    <Path Data="M 18,18 L 23,23 M 20,11 A 9,9 0 1 1 2,11 A 9,9 0 1 1 20,11"
                        Fill="Transparent"
                        Stroke="#A6000000"
                        StrokeThickness="2.1"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Viewbox>

                <TextBox x:Name="Input"
                         Grid.Column="1"
                         Margin="9,0,12,0"
                         VerticalContentAlignment="Center"
                         FontSize="28"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E6000000"
                         CaretBrush="#D9000000" 
                         SelectionBrush="#667AADE8"
                         FontWeight="Light"
                         SpellCheck.IsEnabled="False"/> 

                <Border Grid.Column="2"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#18FFFFFF"
                        BorderBrush="#1F000000"
                        BorderThickness="1"
                        CornerRadius="7">
                    <TextBlock Foreground="#8F000000"
                            FontSize="12"
                            Text="Enter" />
                </Border>                   
            </Grid>

            <Border Grid.Row="1" Background="#1F000000" />    

            <Expander Grid.Row="2" IsExpanded="False" Background="Transparent" BorderThickness="0"
                Header="Options" ExpandDirection="Down"
                Margin="8,4,8,0" Padding="0" FontSize="12" Foreground="#8F000000"
                Expanded="Options_Expanded" Collapsed="Options_Collapsed">
            
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <RadioButton x:Name="StartsWithOption"
                                Content="Starts with"
                                IsChecked="True"
                                GroupName="MatchMode" />

                    <RadioButton Content="Contains"
                                Margin="12,0,0,0"
                                GroupName="MatchMode" />

                    <CheckBox x:Name="CaseSensitiveOption"
                            Content="Case sensitive"
                            Margin="20,0,0,0" />

                    <CheckBox x:Name="RegexOption"
                            Content="Regex"
                            Margin="12,0,0,0" />
                </StackPanel>

            </Expander>
                 
                      
        </Grid>
    </Border>
</Window>
